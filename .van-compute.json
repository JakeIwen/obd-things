    {
      "name": "can-timeseries-correlate-two-chunks",
      "description": "Correlate one cluster wire DID stream against exactly two chronological saved CAN chunks.",
      "profile": "can-log-batch",
      "source_paths": [
        "lib",
        "tools/can_timeseries_correlate.py"
      ],
      "minimum_inputs": 3,
      "maximum_inputs": 3,
      "argv": [
        "{source:tools/can_timeseries_correlate.py}",
        "--wire",
        "{input:0}",
        "--did",
        "1000",
        "--reference-field",
        "u16be:0",
        "--match",
        "nearest",
        "--radius-ms",
        "100",
        "--minimum-samples",
        "20",
        "--minimum-coverage",
        "0.5",
        "--minimum-distinct",
        "4",
        "--top",
        "100",
        "--allow-van-compute-result",
        "--output",
        "{result:report.json}",
        "{input:1}",
        "{input:2}"
      ],
      "outputs": [
        "report.json"
      ]
    },
