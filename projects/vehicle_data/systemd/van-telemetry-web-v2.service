[Unit]
Description=LAN van telemetry dashboard v2 (port 8766, parallel to the 8765 app)
After=van-telemetry.service
Requires=van-telemetry.service
PartOf=van-telemetry.service

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/dev/obd-things
# Passive voltage reads stay allowed for parity with the LAN 8765 drop-in; add --cache-only to forbid them.
ExecStart=/usr/bin/python3 /home/pi/dev/obd-things/projects/vehicle_data/web_v2.py --socket /run/van-telemetry/api.sock --bind 192.168.6.103 --port 8766 --allow-remote-bind --static-root /home/pi/dev/obd-things/projects/vehicle_data/dashboard/dist
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
