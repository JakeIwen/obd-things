[Unit]
Description=Tailscale van telemetry dashboard with locally armed DTC jobs
After=network-online.target tailscaled.service van-telemetry.service van-dtc-batch.path
Wants=network-online.target tailscaled.service
Requires=van-telemetry.service van-dtc-batch.path
PartOf=van-telemetry.service

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/dev/obd-things
EnvironmentFile=/etc/van-telemetry/tailscale-web.env
ExecStart=/usr/bin/python3 /home/pi/dev/obd-things/projects/vehicle_data/web.py --socket /run/van-telemetry/api.sock --bind ${VAN_TELEMETRY_TAILSCALE_BIND} --port 8765 --allow-remote-bind --enable-dtc-jobs --dtc-trusted-origin ${VAN_TELEMETRY_DTC_ORIGIN}
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/run/van-telemetry
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
