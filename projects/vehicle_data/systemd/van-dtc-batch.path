[Unit]
Description=Watch for a fixed DTC batch request file under /run
# Default path ordering is before paths.target/basic.target, unlike the broker.
# Only the triggered worker needs to wait for the broker to start.
Requires=van-telemetry.service
PartOf=van-telemetry.service

[Path]
PathExists=/run/van-telemetry/dtc-batch.request.json
Unit=van-dtc-batch.service

[Install]
WantedBy=multi-user.target
