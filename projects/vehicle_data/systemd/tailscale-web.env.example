# Copy to /etc/van-telemetry/tailscale-web.env after verifying the live address.
# Do not copy these placeholders literally.
VAN_TELEMETRY_TAILSCALE_BIND=TAILSCALE_IPV4
VAN_TELEMETRY_DTC_ORIGIN=http://TAILSCALE_IPV4:8765
# The v2 listener (van-telemetry-web-v2-tailscale.service, port 8766) derives its DTC origin
# as http://${VAN_TELEMETRY_TAILSCALE_BIND}:8766; no separate variable is needed.
