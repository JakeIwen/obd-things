[Unit]
Description=Keep the Pi's onboard USB 2.0 hub port 2 (disk hub chain) powered off
Documentation=file:///home/pi/dev/obd-things/docs/agent-context.md

[Service]
Type=simple
# Root: the port's sysfs attribute is root-writable only. The program is a root-owned copy
# outside the checkout, and it runs the ntfy sender (a file root does not own) as pi.
# No filesystem sandboxing: it writes /sys, opens disks under /dev and the sender reads pi's
# settings.
ExecStart=/usr/local/sbin/vanpi-usb2-disk-hub-off watch
# The watcher has no clean exit; any exit is a fault and it must come back.
Restart=always
RestartSec=5
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=yes
# Holds the once-per-boot alert marker; kept across a restart of this service.
RuntimeDirectory=vanpi-usb2-disk-hub-off
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
SyslogIdentifier=vanpi-usb2-disk-hub-off

[Install]
WantedBy=multi-user.target
