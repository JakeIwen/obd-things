#!/usr/bin/python3 -I
"""vanpi: keep port 2 of the Pi 4's onboard USB 2.0 hub (the disk hub chain's USB 2.0 half) off.

Installed as /usr/local/sbin/vanpi-usb2-disk-hub-off (root-owned copy) and run by
vanpi-usb2-disk-hub-off.service. Contract: docs/agent-context.md, section
"USB 2.0 block for the disk hub chain". Standard library only: it runs as root.

Writing 1 to the port's `disable` attribute disconnects whatever is enumerated behind the port
and stops detection on it. One write is not enough: a connection event already queued in the
kernel can power the port back on, a failed control transfer leaves it on, and a hub reset or
controller recovery can restore power with no event to react to. So this program is the only
writer, and it checks, retries and alerts.

  status  print the block's state; exit 0 only when it holds
  check   one pass: power the port off if it is on; exit 0 only when it holds or there is no
          hub at 1-1
  watch   repeat the pass forever and alert once per boot when the block cannot be held
"""

import errno
import os
import pathlib
import subprocess
import sys
import time

ENV = os.environ
SYSFS = pathlib.Path(ENV.get("USB2_BLOCK_SYSFS", "/sys/bus/usb/devices"))
SYS_BLOCK = pathlib.Path(ENV.get("USB2_BLOCK_SYS_BLOCK", "/sys/block"))
DEV_DIR = pathlib.Path(ENV.get("USB2_BLOCK_DEV", "/dev"))
NOTIFY_COMMAND = ENV.get("USB2_BLOCK_NOTIFY", "/home/pi/scripts/ntfy_send.sh")
# The sender and the settings file it reads are not root-owned, so root never executes them:
# the alert runs as this account. Empty runs the sender as the caller (tests).
NOTIFY_USER = ENV.get("USB2_BLOCK_NOTIFY_USER", "pi")
STATE_DIR = pathlib.Path(ENV.get("USB2_BLOCK_STATE_DIR", "/run/vanpi-usb2-disk-hub-off"))
SETTLE_SECONDS = float(ENV.get("USB2_BLOCK_SETTLE_SECONDS", "2"))
# Boot and re-enumeration are when the port comes back, so the first minute is checked closely.
FAST_INTERVAL_SECONDS = float(ENV.get("USB2_BLOCK_FAST_INTERVAL_SECONDS", "5"))
# A pass is a few sysfs reads and logs nothing while the block holds, so a short interval is cheap;
# a long one leaves the reopened port on long enough for the chain to fault.
SLOW_INTERVAL_SECONDS = float(ENV.get("USB2_BLOCK_SLOW_INTERVAL_SECONDS", "10"))
FAST_PASSES = 12
# Consecutive attempts of one pass that must show the identical snapshot, with a known reader
# still short of its disks, before the reader is cut without them. A write or an observed change
# of the listing restarts the count.
STUCK_SIGHTINGS = 3
# Room for two complete cut cycles: a queued connection event can power the port back on after a
# write, and the reader that comes back is a fresh enumeration with its own STUCK_SIGHTINGS.
ATTEMPTS = 2 * STUCK_SIGHTINGS
# Passes a present hub may lack its port control (its driver still binding) before that is a fault.
GRACE_PASSES = 3

ONBOARD_HUB = ("2109", "3431")
HUB = SYSFS / "1-1"
DISABLE = HUB / "1-1:1.0" / "1-1-port2" / "disable"
CHILD = SYSFS / "1-1.2"
# A block device is behind the port when its real sysfs path runs through the port's child.
BEHIND_PORT = "/1-1/1-1.2/"
# The USB storage this block may disconnect, by vendor:product, with the number of disks each
# registers. The count is how the block knows the kernel has finished registering them: one disk
# of a two-slot reader is not the whole device. Storage that is not listed is never
# disconnected, because how many disks it will bring is unknown.
KNOWN_STORAGE_DISKS = {
    "05e3:0764": 2,  # Genesys two-slot card reader on the first disk hub's port 1
}
PORT_NAME = "port 2 of the onboard USB 2.0 hub"

# Results of one pass.
HELD, FAILED, UNCONTROLLED, NO_HUB = 0, 1, 3, 4
ERROR, WARNING, NOTICE = 3, 4, 5


def say(priority, text):
    """One journal line; systemd reads the <N> prefix as its priority."""
    print("<%d>%s" % (priority, text), file=sys.stderr, flush=True)


def read_attr(path):
    try:
        return path.read_text().strip()
    except OSError:
        return None


def assess():
    """The block's state, as one line.

    held                           disable reads 1 and nothing is enumerated behind the port
    no-hub                         nothing at USB path 1-1
    foreign <vid>:<pid>            1-1 is not the Pi's onboard hub
    uncontrolled child=<word>      the hub is there but its identity or the port control is not
    open disable=<v> child=<word>  the port is on, or something is enumerated behind it

    `disable` alone is not trusted: the kernel does not report a failed port-status read, so the
    block holds only when nothing is enumerated behind the port as well.
    """
    if not HUB.is_dir():
        return "no-hub"
    child = "present" if CHILD.exists() else "absent"
    identity = (read_attr(HUB / "idVendor"), read_attr(HUB / "idProduct"))
    if None in identity:
        return "uncontrolled child=" + child
    if identity != ONBOARD_HUB:
        return "foreign %s:%s" % identity
    if not DISABLE.exists():
        return "uncontrolled child=" + child
    disable = read_attr(DISABLE)
    if disable == "1" and child == "absent":
        return "held"
    return "open disable=%s child=%s" % (disable if disable is not None else "unreadable", child)


def release(claims):
    for descriptor in claims:
        try:
            os.close(descriptor)
        except OSError:
            pass


# power_off's outcomes.
WRITTEN, REFUSED, UNSETTLED = "written", "refused", "unsettled"


def storage_class(entry):
    """An interface entry's bInterfaceClass; None when the entry vanished, OSError otherwise."""
    try:
        return (entry / "bInterfaceClass").read_text().strip()
    except FileNotFoundError:
        return None


def storage_behind_port():
    """A comparable snapshot of what is, or is about to be, a disk behind the port.

    ([(USB mass-storage interface, vendor:product)], {disk name: (device number, sectors, real
    sysfs path)}). A storage interface exists before its disks do (the kernel registers them a
    second or more after the USB probe, one by one), so it is part of the snapshot. An entry that
    vanished while being read is skipped; any other failure to read or resolve an entry raises
    OSError, because an uninspectable entry is not evidence that it is not storage.
    """
    interfaces = []
    for entry in SYSFS.iterdir():
        name = entry.name
        if name.startswith("1-1.2") and name[5:6] in (".", ":") and ":" in name:
            if storage_class(entry) == "08":
                device = SYSFS / name.split(":")[0]
                model = "%s:%s" % (read_attr(device / "idVendor"), read_attr(device / "idProduct"))
                interfaces.append((name, model))
    disks = {}
    for entry in SYS_BLOCK.iterdir():
        try:
            real = os.path.realpath(str(entry), strict=True)
        except FileNotFoundError:
            continue
        if BEHIND_PORT in real + "/":
            disks[entry.name] = (read_attr(pathlib.Path(real, "dev")), read_attr(pathlib.Path(real, "size")), real)
    return sorted(interfaces), disks


class Sightings:
    """How many consecutive attempts of one pass saw the same incomplete snapshot.

    Local to one enforce call: each pass starts fresh, and nothing outlives it.
    """

    def __init__(self):
        self.snapshot = None
        self.count = 0

    def see(self, snapshot):
        self.count = self.count + 1 if snapshot == self.snapshot else 1
        self.snapshot = snapshot
        return self.count

    def reset(self):
        self.snapshot = None
        self.count = 0


def short_readers(snapshot):
    """[(interface, disks listed, disks known)] for each known reader listing fewer than it has."""
    interfaces, disks = snapshot
    short = []
    for interface, model in interfaces:
        expected = KNOWN_STORAGE_DISKS.get(model)
        found = sum(1 for _number, _sectors, real in disks.values() if "/%s/" % interface in real)
        if expected is not None and found < expected:
            short.append((interface, found, expected))
    return short


def cut_note(short):
    """The one journal note for cutting readers without all their disks."""
    return "; ".join(
        "storage interface %s behind it has shown %d of its %d disks on %d checks; cutting it without them"
        % (interface, found, expected, STUCK_SIGHTINGS) for interface, found, expected in short)


def storage_not_ready(snapshot, sightings):
    """Why the listed storage may not be claimed and cut yet: (outcome, why), or None.

    Every disk must sit behind a listed storage interface, every interface must be a known
    model, and a known model must show exactly its number of disks: more is REFUSED. Fewer
    means the kernel may still be registering them (UNSETTLED), but a reader whose kernel
    probe is failing never registers any, so the identical incomplete snapshot seen on
    STUCK_SIGHTINGS consecutive attempts of the pass is ready (None; short_readers names what is
    missing). A different snapshot restarts that count, and so does a complete one.
    """
    interfaces, disks = snapshot
    paths = {name: real for name, (_number, _sectors, real) in disks.items()}
    for name, real in sorted(paths.items()):
        if not any("/%s/" % interface in real for interface, _model in interfaces):
            return REFUSED, "%s behind it belongs to no listed storage interface" % name
    for interface, model in interfaces:
        expected = KNOWN_STORAGE_DISKS.get(model)
        if expected is None:
            return REFUSED, "storage device %s (%s) behind it is not one this block may disconnect" % (
                interface, model)
        found = sum(1 for real in paths.values() if "/%s/" % interface in real)
        if found > expected:
            return REFUSED, "storage interface %s behind it shows %d disks where %d are known" % (
                interface, found, expected)
    short = short_readers(snapshot)
    if not short:
        sightings.reset()
        return None
    if sightings.see(snapshot) < STUCK_SIGHTINGS:
        interface, found, expected = short[0]
        return UNSETTLED, "storage interface %s behind it shows %d of its %d disks" % (
            interface, found, expected)
    return None


def claim(name, device_number):
    """Take the kernel's exclusive claim on one whole disk. Returns (descriptor, None) or (None, why).

    The open fails with EBUSY while the disk or a partition of it is mounted, is swap or is held
    by another block device, and while the claim is held no mount of it can begin. It is tried
    whatever capacity the disk reports (a failed capacity read shows as 0), and without waiting
    for a medium, so a card reader with no card is claimed too.
    """
    flags = os.O_RDONLY | os.O_EXCL | os.O_NONBLOCK | os.O_CLOEXEC
    try:
        descriptor = os.open(str(DEV_DIR / name), flags)
    except OSError as error:
        if error.errno == errno.EBUSY:
            return None, "%s behind it is mounted or held" % name
        return None, "%s behind it cannot be claimed (%s)" % (name, error.strerror)
    try:
        opened = os.fstat(descriptor).st_rdev
    except OSError as error:
        os.close(descriptor)
        return None, "%s behind it cannot be inspected (%s)" % (name, error.strerror)
    if device_number != "%d:%d" % (os.major(opened), os.minor(opened)):
        os.close(descriptor)
        return None, "%s behind it is not the device sysfs describes" % name
    return descriptor, None


def power_off(log, sightings):
    """One guarded write of 1 to the port's control: (outcome, why); WRITTEN's why is the cut note.

    Powering the port off disconnects everything behind it. The owner's rule is to keep disks
    from attaching over USB 2.0, not to pull one that is in use (a disk can fall back to USB 2.0
    and be mounted before a pass sees it). So every disk behind the port is claimed first and
    the claims are held across the write; a disk that cannot be claimed or inspected is REFUSED.
    Only known storage is cut, and only once all of its disks are listed (storage_not_ready);
    while the kernel is still registering them nothing is written (UNSETTLED; the caller tries
    again), until the same incomplete listing has stood for STUCK_SIGHTINGS consecutive attempts
    of the pass, when the reader is cut with the disks it has. The count restarts when the second
    listing differs from the first and after every write. The one WARNING that a reader is cut
    incomplete (the cut note, also returned with WRITTEN) is logged only after every claim
    succeeded and the second listing matched, immediately before the write. The claims cover the disks of one snapshot, so the
    snapshot is taken again after claiming: if storage appeared, left or changed meanwhile,
    nothing is written either. Two listings are not a lock on the USB topology: a device whose
    storage interface appears after the second listing, and whose disks are registered and
    mounted before the kernel carries out the write, is not covered. Residual for a reader cut
    while incomplete: a disk of it that the kernel registers and something mounts between the
    second listing and the write (udisks2 and a desktop file manager run on this host, so an
    automount is possible) is disconnected unclaimed.
    """
    claims = []
    try:
        try:
            before = storage_behind_port()
        except OSError as error:
            return REFUSED, "the storage behind it cannot be listed (%s)" % error.strerror
        not_ready = storage_not_ready(before, sightings)
        if not_ready:
            return not_ready
        for name, (device_number, _sectors, _real) in sorted(before[1].items()):
            if device_number is None:
                return REFUSED, "%s behind it cannot be inspected" % name
            descriptor, why = claim(name, device_number)
            if why:
                return REFUSED, why
            claims.append(descriptor)
        try:
            after = storage_behind_port()
        except OSError as error:
            return REFUSED, "the storage behind it cannot be listed (%s)" % error.strerror
        if after != before:
            sightings.reset()
            return UNSETTLED, "the storage behind it changed while its disks were being claimed"
        note = cut_note(short_readers(before))
        if note:
            log(WARNING, note)
        sightings.reset()
        try:
            DISABLE.write_text("1\n")
        except OSError as error:
            log(WARNING, "writing 1 to %s failed (%s)" % (DISABLE, error.strerror))
        return WRITTEN, note
    finally:
        release(claims)


def enforce(log):
    """One pass: (result, reason). Only a port read back as held, twice, counts as powered off.

    HELD's reason is the cut note of the write that led to it ("" when nothing was cut incomplete).
    """
    state = assess()
    attempt = 0
    unsettled = ""
    written_note = ""
    sightings = Sightings()
    while True:
        if state == "held":
            return HELD, ""
        if state == "no-hub":
            return NO_HUB, ""
        if state.startswith("foreign"):
            reason = "USB path 1-1 is not the Pi's onboard hub (%s); port 2 left alone" % state
            log(ERROR, reason)
            return FAILED, reason
        if state == "uncontrolled child=absent":
            # May be a hub whose driver is still binding; the caller decides how long that lasts.
            return UNCONTROLLED, "the onboard USB 2.0 hub is present without its port 2 control"
        if state.startswith("uncontrolled"):
            reason = "a device is enumerated behind %s and the port has no control attribute" % PORT_NAME
            log(ERROR, reason)
            return FAILED, reason
        if attempt == ATTEMPTS:
            reason = "%s is still on after %d attempts (%s)%s" % (PORT_NAME, ATTEMPTS, state, unsettled)
            log(ERROR, reason)
            return FAILED, reason
        attempt += 1
        log(WARNING, "%s is on (%s); powering it off, attempt %d of %d" % (PORT_NAME, state, attempt, ATTEMPTS))
        outcome, why = power_off(log, sightings)
        if outcome == REFUSED:
            reason = "%s is on and %s; not disconnecting it" % (PORT_NAME, why)
            log(ERROR, reason)
            return FAILED, reason
        # The last attempt's own reason, not an earlier one's.
        unsettled = "; " + why if outcome == UNSETTLED else ""
        if outcome == WRITTEN:
            written_note = why
        if outcome == UNSETTLED:
            log(WARNING, "%s; nothing written on attempt %d" % (why, attempt))
        time.sleep(SETTLE_SECONDS)
        state = assess()
        if state == "held":
            # A queued connection event can power the port back on after a successful write.
            time.sleep(SETTLE_SECONDS)
            state = assess()
            if state == "held":
                log(NOTICE, "%s is off again" % PORT_NAME)
                return HELD, written_note


def alert_once(reason):
    """One phone alert per boot: the marker lives under /run."""
    marker = STATE_DIR / "alerted"
    if marker.exists():
        return
    command = [
        NOTIFY_COMMAND,
        "vanpi USB 2.0 block FAILED",
        "The disk hub chain's USB 2.0 half cannot be kept off: %s. The CAN adapters share that "
        "hub. See obd-things docs/agent-context.md, USB 2.0 block for the disk hub chain." % reason,
        "high",
        "warning",
    ]
    if NOTIFY_USER:
        command = [
            "/usr/bin/setpriv", "--reuid", NOTIFY_USER, "--regid", NOTIFY_USER,
            "--init-groups", "--reset-env", "--",
        ] + command
    try:
        STATE_DIR.mkdir(mode=0o700, parents=True, exist_ok=True)
        if not os.access(NOTIFY_COMMAND, os.X_OK):
            raise OSError("%s is not executable" % NOTIFY_COMMAND)
        if subprocess.run(command, timeout=60, stdin=subprocess.DEVNULL).returncode != 0:
            raise OSError("the sender failed")
        marker.touch()
    except (OSError, subprocess.SubprocessError) as error:
        say(ERROR, "the USB 2.0 block failed and the alert could not be delivered (%s)" % error)


def watch():
    passes = 0
    failing = False
    uncontrolled = 0

    def silent(priority, text):
        pass

    while True:
        # While it keeps failing, say so once, not on every pass.
        result, reason = enforce(silent if failing else say)
        if result == UNCONTROLLED:
            uncontrolled += 1
            if uncontrolled > GRACE_PASSES:
                result = FAILED
                reason = "%s (for %d passes)" % (reason, uncontrolled)
                if not failing:
                    say(ERROR, reason)
        else:
            uncontrolled = 0
        if result == HELD:
            if failing:
                say(NOTICE, "the USB 2.0 block holds again" + ("; " + reason if reason else ""))
            failing = False
        elif result == FAILED:
            failing = True
            alert_once(reason)
        # NO_HUB and an UNCONTROLLED pass inside the grace change nothing: no port to judge.
        passes += 1
        time.sleep(FAST_INTERVAL_SECONDS if passes <= FAST_PASSES else SLOW_INTERVAL_SECONDS)


def main(arguments):
    verb = arguments[1] if len(arguments) == 2 else ""
    if verb == "status":
        state = assess()
        print(state)
        return 0 if state == "held" else 1
    if verb == "check":
        result, reason = enforce(say)
        if result == NO_HUB:
            return 0
        if result == UNCONTROLLED:
            say(ERROR, reason)
        return result
    if verb == "watch":
        watch()
    print("usage: vanpi-usb2-disk-hub-off status|check|watch", file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv))
